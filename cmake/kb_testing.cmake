# kb-core test helpers: the strict flags every kb-core translation unit is built with, header self-containment
# checks, unit-test executables on the dependency-free harness (tests/harness/), compile-fail tests and fuzz
# targets. Included by the root CMakeLists.txt; each part calls the functions from its own tests/ and fuzz/.
#
#   kb_strict_target(<target>)                         ISO C++20, no exceptions, no RTTI, warnings as errors
#   kb_header_checks(<part> <out-var> HEADERS ...)      one generated .cpp per listed header (relative to inc/)
#   kb_add_unit_test(<name> SOURCES ... LIBS ...)       a test executable and its CTest entry
#   kb_add_compile_fail_tests(<part> <dir> SOURCES ... LIBS ...)  each file must fail with its "EXPECT: <regex>"
#   kb_add_fuzz_targets(<part> <dir> TARGETS ... LIBS ...)  fuzz_<name> (libFuzzer, Clang), fuzz_replay_<name> (CTest)
# Sources are always listed by name (handbook KB-BLD-002: no file(GLOB)).
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 The kb-core authors
include_guard(GLOBAL)

# -pedantic-errors and the C++20 deprecations as errors; -Wswitch-enum so a switch names every enumerator
# (MISRA C++:2023 Rule 9.4.2). GCC adds its flow warnings, which fire only with optimisation (see the -O2 build).
set(KB_STRICT_FLAGS -fno-exceptions -fno-rtti -Wall -Wextra -Wpedantic -pedantic-errors -Wshadow -Wconversion
    -Wsign-conversion -Wdeprecated -Wdeprecated-enum-enum-conversion -Wdeprecated-enum-float-conversion
    -Wimplicit-fallthrough -Wswitch-enum -Wformat=2 -Wnull-dereference -Wundef -Wcast-qual -Wold-style-cast -Werror)
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  list(APPEND KB_STRICT_FLAGS -Wmaybe-uninitialized -Wstringop-overflow=4 -Wduplicated-cond
       -Wlogical-op)
  if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 13)
    list(APPEND KB_STRICT_FLAGS -Wdangling-reference)
  endif()
endif()
# The standard library's own bounds checks, so an out-of-range span or array access traps in tests and fuzzers.
set(KB_TEST_DEFINITIONS _GLIBCXX_ASSERTIONS=1 _LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST)

function(kb_strict_target target)
  target_compile_features(${target} PRIVATE ${KB_CXX_BUILD_FEATURE})
  set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
  target_compile_options(${target} PRIVATE ${KB_STRICT_FLAGS})
endfunction()

# One translation unit per public header: each header compiles on its own, first in its unit, as ISO C++ of
# KB_CPP_STANDARD (the floor in kb.yml unless a build asks for a newer one).
function(kb_header_checks part out_var)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "HEADERS")
  set(checks "")
  foreach(rel IN LISTS ARG_HEADERS)
    if(NOT EXISTS "${KB_LIB_DIR}/${part}/inc/${rel}")
      message(FATAL_ERROR "[kb] header check: ${KB_LIB_DIR}/${part}/inc/${rel} does not exist")
    endif()
    string(MAKE_C_IDENTIFIER "${rel}" id)
    set(check "${CMAKE_BINARY_DIR}/kb_header_checks/${id}.cpp")
    string(CONCAT content "// Generated by cmake/kb_testing.cmake: ${rel} compiles on its own as ISO C++${KB_CPP_STANDARD}.\n"
      "#include \"${rel}\"\n"
      "static_assert(__cplusplus == ${KB_CPLUSPLUS}, \"the header check builds as -std=c++${KB_CPP_STANDARD}\");\n")
    set(old "")
    if(EXISTS "${check}")
      file(READ "${check}" old)
    endif()
    if(NOT old STREQUAL content)
      file(WRITE "${check}" "${content}")
    endif()
    list(APPEND checks "${check}")
  endforeach()
  set(${out_var} "${checks}" PARENT_SCOPE)
endfunction()

function(kb_add_unit_test name)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "SOURCES;LIBS")
  add_executable(${name} "${KB_TESTS_DIR}/harness/kb_test_main.cpp" ${ARG_SOURCES})
  kb_strict_target(${name})
  target_include_directories(${name} PRIVATE "${KB_TESTS_DIR}/harness")
  target_compile_definitions(${name} PRIVATE ${KB_TEST_DEFINITIONS})
  target_link_libraries(${name} PRIVATE ${ARG_LIBS})
  add_test(NAME ${name} COMMAND ${name})
  # The same sources at -O2, compiled only: GCC's flow warnings need optimisation (ESP-IDF Release builds).
  add_library(${name}_o2 OBJECT ${ARG_SOURCES})
  kb_strict_target(${name}_o2)
  target_include_directories(${name}_o2 PRIVATE "${KB_TESTS_DIR}/harness")
  target_link_libraries(${name}_o2 PRIVATE ${ARG_LIBS})
  target_compile_options(${name}_o2 PRIVATE -O2)
endfunction()

# Compile-time contract tests: each file must fail to build, for the reason in its "EXPECT: <regex>" line.
function(kb_add_compile_fail_tests part dir)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "SOURCES;LIBS")
  foreach(file IN LISTS ARG_SOURCES)
    set(src "${dir}/${file}")
    get_filename_component(stem "${src}" NAME_WE)
    file(STRINGS "${src}" expect REGEX "EXPECT: ")
    string(REGEX REPLACE ".*EXPECT: " "" expect "${expect}")
    if(expect STREQUAL "")
      message(FATAL_ERROR "[kb] ${src} has no 'EXPECT: <regex>' line")
    endif()
    set(target kb_${part}_compile_fail_${stem})
    add_library(${target} OBJECT EXCLUDE_FROM_ALL "${src}")
    kb_strict_target(${target})
    target_link_libraries(${target} PRIVATE ${ARG_LIBS})
    add_test(NAME ${target} COMMAND ${CMAKE_COMMAND} --build ${CMAKE_BINARY_DIR} --target ${target})
    set_tests_properties(${target} PROPERTIES PASS_REGULAR_EXPRESSION "${expect}")
  endforeach()
endfunction()

# Each <dir>/fuzz_<name>.cpp defines LLVMFuzzerTestOneInput(). fuzz_replay_<name> replays <dir>/corpus/fuzz_<name>/
# as a CTest on any compiler; with KB_BUILD_FUZZERS (Clang) fuzz_<name> is the libFuzzer binary with ASan and UBSan.
function(kb_add_fuzz_targets part dir)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "TARGETS;LIBS")
  foreach(name IN LISTS ARG_TARGETS)
    set(src "${dir}/${name}.cpp")
    add_executable(fuzz_replay_${name} "${src}" "${KB_TESTS_DIR}/harness/kb_fuzz_replay_main.cpp")
    kb_strict_target(fuzz_replay_${name})
    target_compile_definitions(fuzz_replay_${name} PRIVATE ${KB_TEST_DEFINITIONS})
    target_link_libraries(fuzz_replay_${name} PRIVATE ${ARG_LIBS})
    add_test(NAME kb_${part}_${name}_corpus COMMAND fuzz_replay_${name} "${dir}/corpus/${name}")
    if(KB_BUILD_FUZZERS)
      add_executable(${name} "${src}")
      kb_strict_target(${name})
      target_compile_definitions(${name} PRIVATE ${KB_TEST_DEFINITIONS})
      target_link_libraries(${name} PRIVATE ${ARG_LIBS})
      target_compile_options(${name} PRIVATE -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=all -g -O1)
      target_link_options(${name} PRIVATE -fsanitize=fuzzer,address,undefined)
    endif()
  endforeach()
endfunction()
