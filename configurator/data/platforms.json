    "uart":    {"instance": "uart", "shared": false, "bus_pins": 2, "pins_per_device": 0, "default_model": "owner",   "label": "UART"},
    "modbus":  {"instance": "uart", "shared": true,  "bus_pins": 3, "pins_per_device": 0, "default_model": "owner",   "label": "Modbus RTU (UART, RS-485)"},
    "can":     {"instance": "can",  "shared": true,  "bus_pins": 2, "pins_per_device": 0, "default_model": "owner",   "label": "CAN"},
    "canopen": {"instance": "can",  "shared": true,  "bus_pins": 2, "pins_per_device": 0, "default_model": "owner",   "label": "CANopen (CAN)"},
    "adc":     {"instance": "adc",  "shared": true,  "bus_pins": 0, "pins_per_device": 1, "default_model": "guarded", "label": "ADC channel"},
    "pio":     {"instance": "pio",  "shared": false, "bus_pins": 1, "pins_per_device": 0, "default_model": "owner",   "label": "Timed pulse output (PIO, RMT on ESP32)"},
