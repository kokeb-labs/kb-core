    {"id": "threadx", "label": "ThreadX (Eclipse ThreadX)", "kb_rtos": "THREADX", "status": "supported"},
    {"id": "none", "label": "None (bare metal, one context)", "kb_rtos": "NONE", "status": "supported"},
    {"id": "host", "label": "Host threads (std::thread)", "kb_rtos": "HOST", "status": "supported"}
  ],
