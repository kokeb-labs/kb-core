# Driver submodules (ADR-0002, ADR-0012): components/drivers/driver-<chip>, url
# https://github.com/kokeb-labs-drivers/driver-<chip>.git, each pinned to the commit of a vX.Y.Z or vX.Y.Z-rc.N tag
# recorded in components/drivers/drivers.lock.yml. Never a `branch =` entry.
[submodule "components/drivers/driver-mcp9700"]
	path = components/drivers/driver-mcp9700
	url = https://github.com/kokeb-labs-drivers/driver-mcp9700.git
