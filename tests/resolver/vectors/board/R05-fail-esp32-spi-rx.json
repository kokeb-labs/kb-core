{
  "description": "ESP32: the SPI receive rounds up to 4 bytes, staging 1030 is not a multiple of 4: the DMA would write past the buffer",
  "board": {
    "board": "example-c6",
    "mcu": {
      "family": "esp32",
      "target": "esp32"
    },
    "memory": {
      "regions": {
        "internal": {
          "cache": "none",
          "align": 4
        }
      }
    },
    "dma": {
      "streams": {
        "spi2": {
          "driver": "spi_master",
          "host": "SPI2"
        },
        "adc": {
          "driver": "adc_continuous",
          "frame_bytes": 256,
          "frames": 4
        }
      }
    },
    "buses": {
      "spi2": {
        "kind": "spi",
        "model": "owner",
        "dma": true,
        "staging_bytes": 1030,
        "devices": [
          {
            "driver": "bno08x",
            "max_frame_bytes": 1024
          }
        ]
      }
    }
  },
  "sdkconfig": {
    "CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE": "y"
  },
  "expect": {
    "ok": false,
    "exit": 1,
    "findings": [
      {
        "rule": "R5",
        "code": "dma.spi_rx_length_multiple",
        "severity": "error",
        "subject": "bus:spi2"
      }
    ]
  }
}
