{
  "description": "ESP32-C6: an ADC frame of 254 bytes is not a whole number of 4-byte conversion results",
  "board": {
    "board": "example-c6",
    "mcu": {
      "family": "esp32",
      "target": "esp32c6"
    },
    "memory": {
      "regions": {
        "internal": {
          "cache": "none",
          "align": 4
        }
      }
    },
    "dma": {
      "streams": {
        "spi2": {
          "driver": "spi_master",
          "host": "SPI2"
        },
        "adc": {
          "driver": "adc_continuous",
          "frame_bytes": 254,
          "frames": 4,
          "iram_safe": true
        }
      }
    },
    "buses": {
      "spi2": {
        "kind": "spi",
        "model": "owner",
        "dma": true,
        "staging_bytes": 1028,
        "devices": [
          {
            "driver": "bno08x",
            "max_frame_bytes": 1024
          }
        ]
      }
    }
  },
  "sdkconfig": {
    "CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE": "y"
  },
  "expect": {
    "ok": false,
    "exit": 1,
    "findings": [
      {
        "rule": "R5",
        "code": "dma.adc_frame_not_multiple",
        "severity": "error",
        "subject": "stream:adc"
      }
    ]
  }
}
