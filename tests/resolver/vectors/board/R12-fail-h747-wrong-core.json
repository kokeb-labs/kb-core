{
  "description": "H747, image on the CM7: the stream is declared for the CM4",
  "board": {
    "board": "vector-h747",
    "mcu": {
      "family": "stm32",
      "device": "STM32H747XI",
      "core": "cm7"
    },
    "rtos": {
      "name": "freertos",
      "max_syscall_priority": 5,
      "priority_bits": 4
    },
    "memory": {
      "regions": {
        "d2_dma": {
          "base": "0x30000000",
          "size": "0x8000",
          "cache": "none",
          "masters": [
            "dma1",
            "dma2"
          ],
          "mpu_region": 0
        }
      }
    },
    "dma": {
      "buffers": {
        "spi1_rx_buf": {
          "region": "d2_dma",
          "bytes": 256
        }
      },
      "streams": {
        "spi1_rx": {
          "engine": "dma1",
          "stream": 0,
          "request": "SPI1_RX",
          "priority": "high",
          "irq_priority": 5,
          "notify": "task",
          "buffer": "spi1_rx_buf",
          "core": "cm4"
        }
      }
    }
  },
  "expect": {
    "ok": false,
    "exit": 1,
    "findings": [
      {
        "rule": "R12",
        "code": "dma.stream_wrong_core",
        "severity": "error",
        "subject": "stream:spi1_rx"
      }
    ]
  }
}
