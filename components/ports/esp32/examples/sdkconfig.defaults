# kb-core ESP32 examples (ESP32-C6), merged with idf.py set-target.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# kb-core is built like its host tests: no exceptions, no RTTI.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# FreeRTOS at 1000 Hz, so millisecond waits are whole ticks.
CONFIG_FREERTOS_HZ=1000
# kb::rtos uses the static allocation API only.
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
