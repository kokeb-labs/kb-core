{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokeb-labs.github.io/kb-core/schemas/vex.schema.json",
  "title": "kb-vex/1: reviewed advisories of the pinned components (a VEX-style list)",
  "description": "Written by hand in tools/vuln/reviewed.json, read by tools/vuln/scan.py. An entry says that an advisory the scan lists for a component was reviewed against its primary source, with the reason and the source. An entry applies only while the scanned version of the component equals component_version; when the pin moves, the advisory is open again. Only the status fixed_in_pinned_version is used so far; not_affected is allowed by the schema and unused. SPDX-License-Identifier: MIT. Copyright (c) 2026 The kb-core authors.",
  "type": "object",
  "required": [
    "schema",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kb-vex/1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "aliases",
          "component",
          "component_version",
          "status",
          "reason",
          "source",
          "reviewed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^.+$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^.+$"
            }
          },
          "component": {
            "type": "string",
            "pattern": "^.+$"
          },
          "component_version": {
            "type": "string",
            "pattern": "^.+$"
          },
          "status": {
            "enum": [
              "fixed_in_pinned_version",
              "not_affected"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^.+$"
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "reviewed": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
